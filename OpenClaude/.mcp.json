{
  "mcpServers": {
    "nixos": {
      "type": "stdio",
      "command": "nix",
      "args": ["run", "github:utensils/mcp-nixos", "--"]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "Authorization": "Bearer YOUR_CONTEXT7_API_KEY"
      }
    },
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/spacecraft-software"]
    },
    "fetch": {
      "type": "stdio",
      "command": "uvx",
      "args": ["--with", "mcp<2", "mcp-server-fetch"]
    },
    "engram": {
      "type": "stdio",
      "command": "engram",
      "args": ["--db", "/home/mj/.local/share/engram/engram.db", "mcp"]
    },
    "brave-search": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@brave/brave-search-mcp-server"],
      "env": {
        "BRAVE_API_KEY": "YOUR_BRAVE_API_KEY"
      }
    },
    "sequential-thinking": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "perplexity": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "perplexity-mcp"],
      "env": {
        "PERPLEXITY_API_KEY": "YOUR_PERPLEXITY_API_KEY"
      }
    },
    "terminal": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "mcp-server-terminal"],
      "env": {
        "RUST_LOG": "error",
        "NO_COLOR": "1",
        "TERM": "dumb"
      }
    },
    "crates": {
      "type": "stdio",
      "command": "crates-mcp",
      "env": {
        "RUST_LOG": "error",
        "NO_COLOR": "1",
        "TERM": "dumb"
      }
    },
    "bravais-cli": {
      "type": "stdio",
      "command": "bravais-cli",
      "args": ["mcp"]
    },
    "github": {
      "type": "stdio",
      "command": "nix",
      "args": ["run", "nixpkgs#github-mcp-server", "--", "stdio"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "YOUR_GITHUB_PERSONAL_ACCESS_TOKEN",
        "GITHUB_TOOLSETS": "context,repos,issues,pull_requests,actions",
        "GITHUB_READ_ONLY": "1"
      }
    },
    "obscura": {
      "type": "stdio",
      "command": "obscura",
      "args": ["mcp"]
    }
  }
}
